FROM python:3.12.13-slim-trixie

WORKDIR /app
ADD . .
RUN pip install poetry && poetry config virtualenvs.create false && poetry install --without dev -vv -E mysql -E postgresql -E oracle -E mssql

EXPOSE 8820
CMD ["uvicorn", "watchmen_rest_task_hub.main:app", "--host", "0.0.0.0", "--port", "8820"]
